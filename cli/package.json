{
  "name": "@fabricmc/cli",
  "type": "module",
  "scripts": {
    "build": "npm run fontgen && npm run check && node bundle.ts",
    "start": "npm run build && node bundled.mjs",
    "check": "tsc --noEmit",
    "test": "npm run fontgen && npm run check && node bundle.ts test && node --test test-bundled.mjs",
    "fontgen": "node fontgen.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "version": "0.0.0",
  "description": "Command-line tools for Fabric mod development",
  "license": "MIT",
  "bin": {
    "fabric": "./bundled.mjs"
  },
  "files": [
    "bundled.mjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabricMC/fabricmc.net.git",
    "directory": "cli"
  },
  "devDependencies": {
    "@fabricmc/scripts": "0.0.0",
    "@types/node": "^26.6.5",
    "@types/opentype.js": "^1.3.10",
    "@types/pngjs": "^6.0.5",
    "@types/prompts": "^2.4.9",
    "@types/wawoff2": "^1.0.2",
    "chalk": "^6.0.1",
    "commander": "^14.0.3",
    "esbuild": "0.28.2",
    "fast-xml-parser": "5.11.2",
    "opentype.js": "2.0.0",
    "pngjs": "7.0.0",
    "prompts": "^2.4.2",
    "pureimage": "0.4.20",
    "typescript": "^7.0.2",
    "wawoff2": "2.0.1"
  }
}
