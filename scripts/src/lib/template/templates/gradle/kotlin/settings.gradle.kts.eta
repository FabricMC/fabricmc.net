pluginManagement {
	repositories {
		maven {
			name = "Fabric"
			url = uri("https://maven.fabricmc.net/")
		}
		mavenCentral()
		gradlePluginPortal()
	}

	plugins {
<% const pluginSuffix = it.unobfuscated ? '' : '-remap' -%>
		id("net.fabricmc.fabric-loom<%= pluginSuffix %>") version providers.gradleProperty("loom_version")
<% if (it.kotlin) { -%>
		id("org.jetbrains.kotlin.jvm") version providers.gradleProperty("kotlin_version")
<% } -%>
	}
}

// Should match your modid
rootProject.name = "<%= it.modid %>"
